#!/usr/bin/env bash

set -u

IDLE_TTL=${SHELL_AI_IDLE_TTL:-3600}
MAX_TTL=${SHELL_AI_MAX_TTL:-28800}
MODEL=${SHELL_AI_MODEL:-deepseek/deepseek-flash}
ASK_TOOLS=${SHELL_AI_ASK_TOOLS:-read,grep,find,ls,web_search,fetch_content,get_search_content}
EXEC_TOOLS=${SHELL_AI_EXEC_TOOLS:-read,bash,edit,write,grep,find,ls,web_search,fetch_content,get_search_content}
WEB_EXTENSION=${SHELL_AI_WEB_EXTENSION-npm:pi-web-access}

data_root=${XDG_DATA_HOME:-"$HOME/.local/share"}/shell-ai
cache_root=${XDG_CACHE_HOME:-"$HOME/.cache"}/shell-ai
sessions_dir=$data_root/pi-sessions
scopes_dir=$cache_root/pi-scopes

die() {
  printf 'shell-ai: %s\n' "$*" >&2
  exit 1
}

require_command() {
  command -v "$1" >/dev/null 2>&1 || die "$1 is required"
}

validate_ttl() {
  case $1 in
  '' | *[!0-9]*) die "$2 must be a non-negative integer" ;;
  esac
}

scope_directory() {
  local dir

  dir=$(git -C "$PWD" rev-parse --show-toplevel 2>/dev/null) || dir=$PWD
  (cd "$dir" 2>/dev/null && pwd -P) || return 1
}

scope_key() {
  if command -v shasum >/dev/null 2>&1; then
    printf '%s' "$1" | shasum -a 256 | awk '{print $1}'
  elif command -v sha256sum >/dev/null 2>&1; then
    printf '%s' "$1" | sha256sum | awk '{print $1}'
  else
    printf '%s' "$1" | cksum | awk '{print $1 "-" $2}'
  fi
}

lock_dir=
release_lock() {
  if [[ -n ${lock_dir:-} && -d $lock_dir ]]; then
    rm -f "$lock_dir/pid"
    rmdir "$lock_dir" 2>/dev/null || true
  fi
}

acquire_lock() {
  local attempts=0 owner=

  lock_dir=$1.lock
  while ! mkdir "$lock_dir" 2>/dev/null; do
    if [[ -r $lock_dir/pid ]]; then
      owner=$(sed -n '1p' "$lock_dir/pid" 2>/dev/null || true)
      case $owner in
      '' | *[!0-9]*) owner= ;;
      esac
      if [[ -n $owner ]] && ! kill -0 "$owner" 2>/dev/null; then
        rm -f "$lock_dir/pid"
        rmdir "$lock_dir" 2>/dev/null || true
        continue
      fi
    fi
    attempts=$((attempts + 1))
    [[ $attempts -lt 200 ]] || die "timed out waiting for the session lock"
    sleep 0.05
  done
  printf '%s\n' "$$" >"$lock_dir/pid"
  trap release_lock EXIT HUP INT TERM
}

state_value() {
  "$JQ_BIN" -er "$2" "$1" 2>/dev/null
}

load_valid_session() {
  local state=$1 expected_dir=$2 now=$3
  local stored_dir session_id created_at last_used

  [[ -f $state ]] || return 1
  stored_dir=$(state_value "$state" '.directory') || return 1
  session_id=$(state_value "$state" '.session_id') || return 1
  created_at=$(state_value "$state" '.created_at') || return 1
  last_used=$(state_value "$state" '.last_used') || return 1
  [[ $stored_dir == "$expected_dir" ]] || return 1
  [[ $session_id =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] || return 1
  case $created_at:$last_used in
  *[!0-9:]*) return 1 ;;
  esac
  ((now >= last_used)) || return 1
  ((now - last_used < IDLE_TTL)) || return 1
  ((now >= created_at)) || return 1
  ((now - created_at < MAX_TTL)) || return 1
  printf '%s\n' "$session_id"
}

write_state() {
  local state=$1 directory=$2 session_id=$3 created_at=$4 last_used=$5 tmp

  tmp=$(mktemp "$state.tmp.XXXXXX") || return 1
  if ! "$JQ_BIN" -n \
    --arg directory "$directory" \
    --arg session_id "$session_id" \
    --argjson created_at "$created_at" \
    --argjson last_used "$last_used" \
    '{directory: $directory, session_id: $session_id, created_at: $created_at, last_used: $last_used}' \
    >"$tmp"; then
    rm -f "$tmp"
    return 1
  fi
  chmod 600 "$tmp"
  mv "$tmp" "$state"
}

read_prompt() {
  local marker=$1
  shift
  if [[ $# -gt 0 ]]; then
    printf '%s\n' "$*"
  else
    require_command gum
    gum write --header "$marker" --placeholder '' --cursor.mode static
  fi
}

progress_events() {
  "$JQ_BIN" --unbuffered -nr --argjson live "${1:-false}" '
    def indent: split("\n") | map("    " + .) | join("\n");
    def details: [.result.content[]? | select(.type == "text") | .text] | join("\n");
    def target:
      if .toolName == "bash" then "bash: " + ((.args.command // "") | gsub("\\s*\n\\s*"; " ⏎ "))
      else (.toolName // "tool") +
        ((.args.path // .args.pattern // .args.query // .args.url // "") | tostring |
          if . == "" then "" else ": " + . end)
      end;
    def status: "T\t" + .;
    def persist: "P\t" + gsub("\n"; "\u001e");
    foreach inputs as $event (
      {report: "", tools: {}};
      .report = "" |
      ($event.toolCallId // $event.toolName // "tool") as $id |
      if $live then
        if $event.type == "agent_start" then
          .report = ("Thinking…" | status)
        elif $event.type == "tool_execution_start" then
          .tools[$id] = ($event | target) |
          .report = ("↳ " + .tools[$id] | status)
        elif $event.type == "tool_execution_end" then
          (.tools[$id] // $event.toolName // "tool") as $target |
          if $event.isError then
            .report = ("  ✗ " + $target +
              (if $event.toolName == "bash" then "" else
                ($event | details | if . == "" then "" else "\n" + indent end)
              end) | persist)
          else
            .report = ("✓ " + $target | status)
          end
        else
          .
        end
      elif $event.type == "agent_start" then
        .report = "  ◌ Thinking…"
      elif $event.type == "tool_execution_start" then
        if $event.toolName == "bash" then
          .report = "  ↳ bash: " + (($event.args.command // "") | gsub("\n"; "\n    ")) +
            (if $event.args.timeout then " (timeout: \($event.args.timeout)s)" else " (no timeout)" end)
        else
          .report = "  ↳ " + ($event.toolName // "tool") + "…"
        end
      elif $event.type == "tool_execution_end" then
        if $event.isError then
          .report = "  ✗ " + ($event.toolName // "tool") +
            (if $event.toolName == "bash" then "" else
              ($event | details | if . == "" then "" else "\n" + indent end)
            end)
        else
          .report = "  ✓ " + ($event.toolName // "tool")
        end
      else
        .
      end;
      .report | select(length > 0)
    )
  '
}

# On a terminal, progress stays on one refreshing status line; only failures
# are printed as lasting lines above it.
render_progress() {
  local record pending='' status='Pi is working…' result index=0 width
  local -a frames=(⠋ ⠙ ⠹ ⠸ ⠼ ⠴ ⠦ ⠧ ⠇ ⠏)

  if [[ ! -t 2 || ${TERM:-} == dumb ]]; then
    progress_events false >&2
    return
  fi

  width=$(stty size <&2 2>/dev/null) && width=${width##* } || width=0
  ((width > 10)) || width=80
  width=$((width - 6))
  progress_events true | {
    trap 'printf "\r\033[K" >&2' EXIT
    while :; do
      printf '\r\033[K  %s %s' "${frames[index]}" "${status:0:width}" >&2
      index=$(((index + 1) % ${#frames[@]}))
      record=''
      if IFS= read -r -t 0.12 record; then
        record=$pending$record
        pending=''
        case $record in
        P$'\t'*)
          record=${record#P$'\t'}
          printf '\r\033[K%s\n' "${record//$'\x1e'/$'\n'}" >&2
          status='Pi is working…'
          ;;
        T$'\t'*) status=${record#T$'\t'} ;;
        esac
      else
        result=$?
        pending+=$record
        ((result > 128)) || break
      fi
    done
  }
}

watch_progress() {
  local events=$1 previous_size current_size sleeper=
  trap '[[ -z ${sleeper:-} ]] || kill "$sleeper" 2>/dev/null' EXIT
  previous_size=$(wc -c <"$events")
  while :; do
    sleep 30 >/dev/null 2>&1 &
    sleeper=$!
    wait "$sleeper" || break
    current_size=$(wc -c <"$events")
    if [[ $current_size == "$previous_size" ]]; then
      [[ ! -t 2 ]] || printf '\r\033[K' >&2
      printf '  … Pi is still running (no new events for 30s; Ctrl-C to stop)\n' >&2
    fi
    previous_size=$current_size
  done
}

render_heading() {
  local label=$1 model=${MODEL##*/}
  if [[ -t 2 && -z ${NO_COLOR+x} ]]; then
    printf '\033[1;36m✦ Pi\033[0m  \033[1m%s\033[0m \033[2m· %s\033[0m\n' "$label" "$model" >&2
  else
    printf '✦ Pi  %s · %s\n' "$label" "$model" >&2
  fi
}

shell_instructions() {
  local mode=$1 directory=$2
  cat <<EOF
# 运行环境
你是用户在终端里通过快捷命令调用的助手（shell-ai：ai 提问、ain 开新对话、aix 执行任务）。
- 这是非交互的一次性请求：运行期间用户看不到中间过程，也无法回答你的问题或给命令输入内容。
- 系统：$(uname -sm)；用户 shell：${SHELL##*/}；当前目录：$directory
- 同一目录下的多次调用共享会话，可以引用之前的上下文。

# 回答格式
- 回答会以 Markdown 渲染在终端里：用用户提问的语言，简洁直接，不要铺垫和客套。
- 命令放在带语言标注的代码块里，方便直接复制；命令要适配上面的系统和 shell（例如 macOS 上 BSD 与 GNU 工具的参数差异）。
- 少用标题和表格，终端宽度有限。
EOF
  if [[ $mode == ask ]]; then
    cat <<'EOF'

# 当前模式：ai（问答）
- 只回答问题，不要修改文件或执行有副作用的操作；用户需要执行时，给出可以直接运行的命令并说明关键参数。
- 问题和当前目录有关时，先读取相关文件再回答，不要凭空猜测。
- 需要最新或不确定的信息时使用 web_search，必要时读取网页，并附来源链接。
EOF
  else
    cat <<'EOF'

# 当前模式：aix（执行）
- 直接动手完成任务，而不是只给建议。
- bash 命令必须是非交互的（例如加 -y、--no-pager，设置 GIT_PAGER=cat），可能等待或耗时较长的命令要设置 timeout。
- 不要执行难以撤销或对外生效的操作（大量删除、强制覆盖、git push、发布、付费调用等），除非用户明确要求；遇到这种情况就停下，说明需要用户确认什么。
- 完成后简要总结：做了什么、改了哪些文件、结果如何；失败时说明原因和建议的下一步。
EOF
  fi
}

run_request() {
  local mode=$1 label=$2 directory=$3 session_id=$4 prompt=$5 events=$6
  local status watcher
  local -a args

  args=(--mode json --print --session-dir "$sessions_dir" --model "$MODEL")
  if [[ -n $session_id ]]; then
    args+=(--session-id "$session_id")
  fi
  if [[ -n $WEB_EXTENSION ]]; then
    args+=(--extension "$WEB_EXTENSION")
  fi
  if [[ $mode == ask ]]; then
    args+=(--tools "$ASK_TOOLS")
  else
    args+=(--tools "$EXEC_TOOLS")
  fi
  args+=(--append-system-prompt "$(shell_instructions "$mode" "$directory")")

  render_heading "$label"
  watch_progress "$events" &
  watcher=$!
  (cd "$directory" && pi "${args[@]}" -- "$prompt") | tee "$events" | render_progress
  status=${PIPESTATUS[0]}
  kill "$watcher" 2>/dev/null || true
  wait "$watcher" 2>/dev/null || true
  return "$status"
}

check_events() {
  local events=$1 expected_id=$2 result_id stop_reason error_message
  result_id=$("$JQ_BIN" -rs '[.[] | select(.type == "session") | .id] | first // empty' "$events" 2>/dev/null) || {
    printf 'shell-ai: Pi returned invalid JSON events\n' >&2
    return 1
  }
  [[ $result_id =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] || {
    printf 'shell-ai: Pi returned no session ID\n' >&2
    return 1
  }
  [[ -z $expected_id || $result_id == "$expected_id" ]] || {
    printf 'shell-ai: Pi returned an unexpected session ID\n' >&2
    return 1
  }
  stop_reason=$("$JQ_BIN" -rs '[.[] | select(.type == "message_end" and .message.role == "assistant") | .message.stopReason] | last // empty' "$events" 2>/dev/null) || return 1
  case $stop_reason in
  stop) ;;
  error | aborted)
    error_message=$("$JQ_BIN" -rs '[.[] | select(.type == "message_end" and .message.role == "assistant") | .message.errorMessage // empty] | last // empty' "$events" 2>/dev/null)
    printf 'shell-ai: Pi request %s%s\n' "$stop_reason" "${error_message:+: $error_message}" >&2
    return 1
    ;;
  *)
    printf 'shell-ai: Pi returned no completed answer\n' >&2
    return 1
    ;;
  esac
  "$JQ_BIN" -e -s 'any(.[]; .type == "agent_settled")' "$events" >/dev/null 2>&1 || {
    printf 'shell-ai: Pi did not finish the request\n' >&2
    return 1
  }
  printf '%s\n' "$result_id"
}

render_divider() {
  local width rule
  [[ -t 1 && -t 2 && -z ${NO_COLOR+x} && ${TERM:-} != dumb ]] || return 0
  width=$(stty size <&2 2>/dev/null) && width=${width##* } || width=0
  ((width > 20)) || width=80
  printf -v rule '%*s' $((width - 12)) ''
  printf '\n\033[2m── Answer ─%s\033[0m\n\n' "${rule// /─}" >&2
}

render_answer() {
  local events=$1 answer renderer=${SHELL_AI_RENDERER:-pi} pi_bin
  answer=$("$JQ_BIN" -rs '[.[] | select(.type == "message_end" and .message.role == "assistant" and .message.stopReason == "stop") | .message.content | map(select(.type == "text") | .text) | join("")] | last // empty' "$events" 2>/dev/null) || return 1
  [[ -n $answer ]] || return 1
  render_divider

  if [[ ! -t 1 || -n ${NO_COLOR+x} || $renderer == plain ]]; then
    printf '%s\n' "$answer"
  elif [[ $renderer == pi ]] && command -v shell-ai-render >/dev/null 2>&1; then
    pi_bin=$(command -v pi)
    if printf '%s\n' "$answer" | shell-ai-render "$pi_bin"; then
      return 0
    fi
    printf 'shell-ai: Pi Markdown renderer unavailable; using glow\n' >&2
    if command -v glow >/dev/null 2>&1; then
      printf '%s\n' "$answer" | glow -
    else
      printf '%s\n' "$answer"
    fi
  elif command -v glow >/dev/null 2>&1; then
    printf '%s\n' "$answer" | glow -
  else
    printf '%s\n' "$answer"
  fi
}

ask() {
  local mode=$1 force_new=$2
  shift 2
  local directory key state now prompt session_id= result_id created_at events finished label

  local marker
  case $mode:$force_new in
  exec:*) marker="✦ aix · Execute — Pi can run tools in this directory" ;;
  ask:1) marker="✦ ain · New chat — starts a fresh session" ;;
  *) marker="✦ ai · Ask — continues this directory's session" ;;
  esac
  prompt=$(read_prompt "$marker" "$@") || return
  [[ -n $prompt ]] || return
  directory=$(scope_directory) || die "cannot resolve the current directory"
  key=$(scope_key "$directory") || die "cannot calculate the scope key"
  state=$scopes_dir/$key.json
  acquire_lock "$state"

  now=$(date +%s)
  if [[ $force_new != 1 ]]; then
    session_id=$(load_valid_session "$state" "$directory" "$now" || true)
  fi
  if [[ -n $session_id ]]; then
    created_at=$(state_value "$state" '.created_at') || created_at=$now
  else
    created_at=$now
  fi

  events=$(mktemp "$cache_root/events.XXXXXX") || die "cannot create an events file"

  case $mode:$force_new in
  exec:*) label=Execute ;;
  ask:1) label="New chat" ;;
  *) label=Ask ;;
  esac
  if ! run_request "$mode" "$label" "$directory" "$session_id" "$prompt" "$events"; then
    rm -f "$events"
    return 1
  fi
  if ! result_id=$(check_events "$events" "$session_id"); then
    rm -f "$events"
    return 1
  fi
  finished=$(date +%s)
  write_state "$state" "$directory" "$result_id" "$created_at" "$finished" || {
    rm -f "$events"
    die "cannot update the session state"
  }
  if ! render_answer "$events"; then
    printf 'shell-ai: the response was saved in session %s, but no text was returned\n' "$result_id" >&2
  fi
  rm -f "$events"
}

current() {
  local directory key state now stored_dir session_id created_at last_used idle_left max_left

  directory=$(scope_directory) || die "cannot resolve the current directory"
  key=$(scope_key "$directory") || die "cannot calculate the scope key"
  state=$scopes_dir/$key.json
  acquire_lock "$state"
  [[ -f $state ]] || die "no Pi session for $directory"
  stored_dir=$(state_value "$state" '.directory') || die "invalid session state"
  session_id=$(state_value "$state" '.session_id') || die "invalid session state"
  created_at=$(state_value "$state" '.created_at') || die "invalid session state"
  last_used=$(state_value "$state" '.last_used') || die "invalid session state"
  [[ $stored_dir == "$directory" ]] || die "session directory mismatch"
  now=$(date +%s)
  idle_left=$((IDLE_TTL - (now - last_used)))
  max_left=$((MAX_TTL - (now - created_at)))
  ((idle_left > 0)) || idle_left=0
  ((max_left > 0)) || max_left=0
  printf 'Directory:  %s\nSession:    %s\nIdle left:  %ss\nMax left:   %ss\n' \
    "$stored_dir" "$session_id" "$idle_left" "$max_left"
}

reset() {
  local directory key state

  directory=$(scope_directory) || die "cannot resolve the current directory"
  key=$(scope_key "$directory") || die "cannot calculate the scope key"
  state=$scopes_dir/$key.json
  acquire_lock "$state"
  rm -f "$state"
  printf 'Reset Pi shell-ai session for %s\n' "$directory"
}

usage() {
  cat <<'EOF'
Usage: shell-ai <command> [prompt]

Commands:
  ask [prompt]      Ask Pi with read-only and web tools, reusing a valid directory session
  exec [prompt]     Let Pi execute the task with its default tools
  new [prompt]      Start a new Pi session for the current directory
  current           Show the current directory session
  reset             Forget the current directory session

Environment:
  SHELL_AI_ASK_TOOLS     Comma-separated Pi tools for ask/new
  SHELL_AI_EXEC_TOOLS    Comma-separated Pi tools for exec
  SHELL_AI_WEB_EXTENSION Web extension package for ask/new/exec (empty disables it)
  SHELL_AI_RENDERER      pi (default), glow, or plain
  SHELL_AI_THEME         Pi theme name for rendered answers
EOF
}

case ${1:-} in
-h | --help | help | '')
  usage
  exit 0
  ;;
esac

validate_ttl "$IDLE_TTL" SHELL_AI_IDLE_TTL
validate_ttl "$MAX_TTL" SHELL_AI_MAX_TTL
if [[ -x /usr/bin/jq ]]; then
  JQ_BIN=/usr/bin/jq
else
  JQ_BIN=$(command -v jq) || die "jq is required"
fi
require_command pi
mkdir -p "$sessions_dir" "$scopes_dir" || die "cannot create state directories"

case ${1:-} in
ask)
  shift
  ask ask 0 "$@"
  ;;
exec)
  shift
  ask exec 0 "$@"
  ;;
new)
  shift
  ask ask 1 "$@"
  ;;
current)
  shift
  [[ $# -eq 0 ]] || die "current takes no arguments"
  current
  ;;
reset)
  shift
  [[ $# -eq 0 ]] || die "reset takes no arguments"
  reset
  ;;
*) die "unknown command: $1" ;;
esac
