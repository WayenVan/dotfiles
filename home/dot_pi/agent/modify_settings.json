{{- /* chezmoi:modify-template */ -}}
{{- /* Manage selected preferences and packages; preserve Pi-owned fields. */ -}}
{{- /* Add more package sources to the list below. */ -}}
{{- $packages := list "npm:pi-web-access" "npm:pi-cc-extensions" "npm:@narumitw/pi-btw" -}}
{{- $settings := .chezmoi.stdin | default "{}" | fromJson -}}
{{- $settings
  | setValueAtPath "theme" "dark"
  | setValueAtPath "tuiMode" "fullscreen"
  | setValueAtPath "defaultProvider" "deepseek"
  | setValueAtPath "defaultModel" "deepseek-flash"
  | setValueAtPath "defaultThinkingLevel" "medium"
  | setValueAtPath "hideThinkingBlock" true
  | setValueAtPath "packages" $packages
  | toPrettyJson -}}
